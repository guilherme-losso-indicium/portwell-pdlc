{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/lib/validate_gate.py\" --hook"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(/governance/**)",
      "Edit(/lifecycle/**/*.signature.yaml)",
      "Edit(/evals/cases/**)",
      "Edit(/evals/*.py)",
      "Edit(/evals/*.md)",
      "Edit(/evals/baseline.json)",
      "Edit(/evals/human-grades.yaml)",
      "Edit(/skills/approve/evidence-review.md)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyWrite": [
        "./governance",
        "./lifecycle/**/*.signature.yaml",
        "./evals/cases",
        "./evals/score.py",
        "./evals/run.py",
        "./evals/rubric.md",
        "./evals/baseline.json",
        "./evals/human-grades.yaml",
        "./skills/approve/evidence-review.md"
      ]
    },
    "excludedCommands": [
      "git *",
      "gh *"
    ]
  }
}
